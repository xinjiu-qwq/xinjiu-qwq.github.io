  'twitter':         'fa-x-twitter',
  'x':               'fa-x-twitter',
  'facebook':        'fa-facebook',
  'discord':         'fa-discord',
  'youtube':         'fa-youtube',
  'instagram':       'fa-instagram',
  'reddit':          'fa-reddit',
  'steam':           'fa-steam',
  'twitch':          'fa-twitch',
  'tiktok':          'fa-tiktok',
  'telegram':        'fa-telegram',
  'spotify':         'fa-spotify',
  'soundcloud':      'fa-soundcloud',
  'linkedin':        'fa-linkedin',
  'mastodon':        'fa-mastodon',
  'threads':         'fa-threads',
  'bluesky':         'fa-bluesky',
  'whatsapp':        'fa-whatsapp',
  'line':            'fa-line',
  'weixin':          'fa-weixin',
  'wechat':          'fa-weixin',
  'qq':              'fa-qq',
  'weibo':           'fa-weibo',
  'medium':          'fa-medium',
  'pinterest':       'fa-pinterest',
  'gitlab':          'fa-gitlab',
  'stack-overflow':  'fa-stack-overflow',
  'patreon':         'fa-patreon',
  'paypal':          'fa-paypal',
  'kofi':            'fa-kofi',
  'docker':          'fa-docker',
  'npm':             'fa-npm',
  'python':          'fa-python',
  'rust':            'fa-rust',
  'node-js':         'fa-node-js',
  'js':              'fa-js',
  'html5':           'fa-html5',
  'css3':            'fa-css3',
  'react':           'fa-react',
  'vuejs':           'fa-vuejs',
  'angular':         'fa-angular',
  'linux':           'fa-linux',
  'apple':           'fa-apple',
  'android':         'fa-android',
  'windows':         'fa-windows',
};

// Inline SVG icons for brands not covered by Material Symbols or Font Awesome
var svgIcons = {
  'bilibili': '<svg class="profile-social-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"><path d="M18.5 3.5h-13c-2.5 0-3 1.5-3 3v10c0 2 .5 3 3 3h13c2.5 0 3-1 3-3v-10c0-1.5-.5-3-3-3zM9 13.5c0 .3-.2.5-.5.5s-.5-.2-.5-.5v-4c0-.3.2-.5.5-.5s.5.2.5.5v4zm6 0c0 .3-.2.5-.5.5s-.5-.2-.5-.5v-4c0-.3.2-.5.5-.5s.5.2.5.5v4z"/></svg>',
  'github': '<svg class="profile-social-icon" viewBox="0 0 496 512" width="1em" height="1em" fill="currentColor"><path d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3.3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5.3-6.2 2.3zm44.2-1.7c-2.9.7-4.9 2.6-4.6 4.9.3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8zM97.2 378.5c-1.3 1.3-1.3 3.3 0 4.6 1.3 1.3 3.3 1.3 4.6 0 1.3-1.3 1.3-3.3 0-4.6-1.4-1.3-3.3-1.3-4.6 0zm-20.9-8.5c-1.3 1.3-.3 3.6 1.6 4.6 2 1 4.6.3 5.9-1.3 1.3-1.3.3-3.6-1.6-4.6-2-1-4.6-.3-5.9 1.3zm40.2 14.6c-1.3.3-2.3 2-1.6 3.6.7 1.6 2.6 2.6 4.6 2 1.6-.3 2.6-2 2-3.9-.9-1.6-2.6-2.3-5-1.7zm20.9 7.9c-2.6 1.3-2.3 4.3 1.3 5.2 3.3 1 5.9-1 6.2-3.3.3-2.6-2-3.9-5-3.9-1.3 0-2.3.7-2.6 2zm37.1-4.2c-3 .3-4.6 2.6-3.6 5.2 1 2.3 4.3 3 6.9 2 2.6-1 3.3-3.6 2.3-5.6-.9-1.6-3.3-2.3-5.6-1.6z"/></svg>',
  'qq': '<svg class="profile-social-icon" viewBox="0 0 448 512" width="1em" height="1em" fill="currentColor"><path d="M433.754 420.445c-11.526 1.393-44.86-52.741-44.86-52.741 0 31.345-16.136 72.247-51.051 101.786 16.842 5.192 54.843 19.167 45.803 34.421-7.316 12.343-125.51 7.881-159.632 4.037-34.122 3.844-152.316 8.306-159.632-4.037-9.045-15.25 28.918-29.214 45.783-34.415-34.92-29.539-51.059-70.445-51.059-101.792 0 0-33.334 54.134-44.859 52.741-5.37-.65-12.424-29.644 9.347-99.704 10.261-33.024 21.995-60.478 40.144-105.779C60.683 98.063 108.982.006 224 0c113.737.006 163.156 96.133 160.264 214.963 18.118 45.223 29.912 72.85 40.144 105.778 21.768 70.06 14.716 99.053 9.346 99.704z"/></svg>'

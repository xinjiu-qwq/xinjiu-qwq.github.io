<style>
/* ===== Site preloader (Windows 10 style dots spinner) ===== */
#site-preloader {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.4rem;
  background: var(--page-bg, #f5f5f5);
  transition: opacity 0.45s ease, visibility 0.45s ease;
}
#site-preloader.hide {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.preloader-spinner {
  position: relative;
  width: 44px;
  height: 44px;
}
.preloader-spinner .dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 7px;
  height: 7px;
  margin: -3.5px 0 0 -3.5px;
  border-radius: 50%;
  background: var(--preloader-color, var(--primary, #0ea5e9));
  opacity: 0.15;
  transform: rotate(calc(var(--i) * 45deg)) translateY(-17px);
  animation: preloader-dot 1.2s ease-in-out infinite;
  animation-delay: calc(var(--i) * 0.15s);
}
@keyframes preloader-dot {
  0%, 100% { opacity: 0.15; }
  50%      { opacity: 1; }
}
.preloader-text {
  font-size: 0.95rem;
  color: var(--text-secondary, #666);
  letter-spacing: 0.12em;
  animation: preloader-textPulse 1.6s ease-in-out infinite;
}
@keyframes preloader-textPulse {
  0%, 100% { opacity: 0.55; }
  50%      { opacity: 1; }
}
</style>
<div id="site-preloader" role="status" aria-label="加载中" style="--preloader-color: var(--primary);">
  <div class="preloader-spinner">
    <span class="dot" style="--i:0"></span>
    <span class="dot" style="--i:1"></span>
    <span class="dot" style="--i:2"></span>
    <span class="dot" style="--i:3"></span>
    <span class="dot" style="--i:4"></span>
    <span class="dot" style="--i:5"></span>
    <span class="dot" style="--i:6"></span>
    <span class="dot" style="--i:7"></span>
  </div>
  <div class="preloader-text">加载中…</div>
</div>
